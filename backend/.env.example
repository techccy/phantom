# Phantom 后端环境变量示例。复制为 .env 后按需修改。
# 注意：.env 不入库（见 .gitignore）。

# Redis 连接
PHANTOM_REDIS_URL=redis://localhost:6379/0

# 允许的前端来源（逗号分隔）—— 接入方网站的源都要加进来
# Docker Compose 全栈下官方 demo 走同源 http://localhost；接入 demo 走 :8088
PHANTOM_CORS_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost

# Challenge / Token 生命周期（秒）
PHANTOM_CHALLENGE_TTL=120
PHANTOM_TOKEN_TTL=300

# 画布与时长
PHANTOM_CANVAS_W=480
PHANTOM_CANVAS_H=480
# 方块沿贝塞尔路径的移动时长（秒）—— 决定跟随难度与速度
PHANTOM_CHALLENGE_DURATION=5.0

# 时效校验（手册 §四.2：防止离线慢算）
PHANTOM_MAX_DRIFT_SECONDS=3.0
PHANTOM_CLOCK_SKEW_MS=1500

# 评分（手册 §三、§四）
PHANTOM_PASS_THRESHOLD=0.8
PHANTOM_SMOOTHNESS_EPS=0.08
PHANTOM_SMOOTHNESS_CAP=0.20
PHANTOM_SMOOTHNESS_BIO=0.05
PHANTOM_BUTTER_ORDER=4
PHANTOM_BUTTER_CUTOFF=7.0

# 综合评分权重（Composite = W_DTW·S_DTW + W_BIO·S_Bio；S_Bio 内部 = W_JERK·e + W_ZC·zc + W_PSD·tremor）
# 调大 W_DTW 偏向"跟得准"，调大 W_BIO 偏向"残差有生理特征"
PHANTOM_W_JERK=0.4
PHANTOM_W_ZC=0.3
PHANTOM_W_PSD=0.3
PHANTOM_W_DTW=0.6
PHANTOM_W_BIO=0.4

# DTW 方向拟合衰减尺度：平均每点偏差占对角线此比例时 S_DTW≈0.37；越大越宽松
PHANTOM_DTW_D_REF_RATIO=0.15

# 生理震颤频段（Hz）：人类特征性手抖区间
PHANTOM_TREMOR_LO_HZ=8.0
PHANTOM_TREMOR_HI_HZ=12.0

# _energy_score 残差能量边界（px）：<MIN 视为过度平滑→0；LOW~HIGH 生理区间→1；>MAX 粗糙白噪→0
PHANTOM_ENERGY_MIN=0.1
PHANTOM_ENERGY_LOW=0.3
PHANTOM_ENERGY_HIGH=8.0
PHANTOM_ENERGY_MAX=20.0

# _zc_score 加速度零交叉率边界（次/秒）：人类反馈纠偏 ≈ [RISE, PLATEAU] 满分
PHANTOM_ZC_FLOOR=1.0
PHANTOM_ZC_RISE=1.67
PHANTOM_ZC_PLATEAU=15.0
PHANTOM_ZC_DROP=40.0

# _tremor_score 振幅段边界（px）
PHANTOM_TREMOR_AMP_MIN=0.05
PHANTOM_TREMOR_AMP_LOW=0.3
PHANTOM_TREMOR_AMP_HIGH=8.0
PHANTOM_TREMOR_AMP_MAX=20.0

# _tremor_score 频谱占比段（生理频段功率占比）+ tremor 子分内部权重
PHANTOM_TREMOR_PSD_MIN=0.02
PHANTOM_TREMOR_PSD_LOW=0.4
PHANTOM_TREMOR_PSD_MID=0.13
PHANTOM_W_TREMOR_AMP=0.5
PHANTOM_W_TREMOR_PSD=0.5

# Challenge 视觉参数（下发前端，影响难度）
PHANTOM_TARGET_HALF=22   # 目标方块半边长（画布相对）
PHANTOM_FPS=60           # 帧率（仅约定下发）

# Token HMAC 密钥：生产必须注入稳定随机值（>=32 字节 base64/hex）
# 留空则进程级随机生成（仅适用单进程）
PHANTOM_TOKEN_SECRET=

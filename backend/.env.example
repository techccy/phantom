# Phantom 后端环境变量示例。复制为 .env 后按需修改。
# 注意：.env 不入库（见 .gitignore）。

# Redis 连接
PHANTOM_REDIS_URL=redis://localhost:6379/0

# 允许的前端来源（逗号分隔）—— 接入方网站的源都要加进来
# Docker Compose 全栈下官方 demo 走同源 http://localhost；接入 demo 走 :8088
PHANTOM_CORS_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost

# Challenge / Token 生命周期（秒）
PHANTOM_CHALLENGE_TTL=120
PHANTOM_TOKEN_TTL=300

# 画布与时长
PHANTOM_CANVAS_W=480
PHANTOM_CANVAS_H=480
PHANTOM_CHALLENGE_DURATION=3.0

# 时效校验（手册 §四.2：防止离线慢算）
PHANTOM_MAX_DRIFT_SECONDS=3.0
PHANTOM_CLOCK_SKEW_MS=1500

# 评分（手册 §三、§四）
PHANTOM_PASS_THRESHOLD=0.8
PHANTOM_SMOOTHNESS_EPS=0.08
PHANTOM_SMOOTHNESS_CAP=0.20
PHANTOM_SMOOTHNESS_BIO=0.05
PHANTOM_BUTTER_ORDER=4
PHANTOM_BUTTER_CUTOFF=7.0

# Token HMAC 密钥：生产必须注入稳定随机值（>=32 字节 base64/hex）
# 留空则进程级随机生成（仅适用单进程）
PHANTOM_TOKEN_SECRET=

# Docker Compose 全栈部署的环境变量示例。
# 复制为 .env 后修改，docker compose up 会自动读取。
# 注意：.env 不入库（见 .gitignore）。
#
# 规则速览：
#   - 画布尺寸只改 PHANTOM_CANVAS_W/H（后端生成路径 + 前端渲染共用，单一来源）
#   - 后端 PHANTOM_*：改完重启 backend 容器即生效（docker compose up -d）
#   - 前端 VITE_PARTICLE_*：属构建时注入，改后必须加 --build（docker compose up -d --build）

# ============ 基础 / 安全 ============
# 允许的前端来源（逗号分隔）。
# 接入方网站的源都要加进来，否则浏览器 CORS 会拦截。
# 官方 demo 走同源 http://localhost；接入 demo 走 http://localhost:8088
PHANTOM_CORS_ORIGINS=http://localhost,http://localhost:8088

# Token HMAC 签名密钥：生产【必须】注入稳定随机值（>=32 字节）。
# 留空则进程级随机生成（多 worker/多实例间 token 不可校验，仅适合本地试用）。
# 生成示例：openssl rand -hex 32
PHANTOM_TOKEN_SECRET=

# 调试模式：设为 1/true/yes/on 后，后端会在日志里打印每次 /verify 的全部采集轨迹
# 与原分属明细（综合分、DTW/Bio 子分、各生理特征与子项）。仅用于排查，生产务必关闭。
PHANTOM_DEBUG=

# ============ Challenge / 画布 / 时长 ============
PHANTOM_CANVAS_W=480
PHANTOM_CANVAS_H=480
PHANTOM_CHALLENGE_DURATION=5.0
PHANTOM_TARGET_HALF=22
PHANTOM_FPS=60

# ============ 评分权重 ============
# Composite = W_DTW·S_DTW + W_BIO·S_Bio；S_Bio = W_JERK·e + W_ZC·zc + W_PSD·tremor
PHANTOM_PASS_THRESHOLD=0.8
PHANTOM_W_JERK=0.4
PHANTOM_W_ZC=0.3
PHANTOM_W_PSD=0.3
PHANTOM_W_DTW=0.6
PHANTOM_W_BIO=0.4
PHANTOM_DTW_D_REF_RATIO=0.15

# ============ DSP / 生理特征阈值 ============
# 震颤频段（Hz）
PHANTOM_TREMOR_LO_HZ=8.0
PHANTOM_TREMOR_HI_HZ=12.0
# 残差能量边界（px）
PHANTOM_ENERGY_MIN=0.1
PHANTOM_ENERGY_LOW=0.3
PHANTOM_ENERGY_HIGH=8.0
PHANTOM_ENERGY_MAX=20.0
# 加速度零交叉率（次/秒）
PHANTOM_ZC_FLOOR=1.0
PHANTOM_ZC_RISE=1.67
PHANTOM_ZC_PLATEAU=15.0
PHANTOM_ZC_DROP=40.0
# 震颤振幅（px）
PHANTOM_TREMOR_AMP_MIN=0.05
PHANTOM_TREMOR_AMP_LOW=0.3
PHANTOM_TREMOR_AMP_HIGH=8.0
PHANTOM_TREMOR_AMP_MAX=20.0
# 震颤 PSD 占比 + tremor 子分内部权重
PHANTOM_TREMOR_PSD_MIN=0.02
PHANTOM_TREMOR_PSD_LOW=0.4
PHANTOM_TREMOR_PSD_MID=0.13
PHANTOM_W_TREMOR_AMP=0.5
PHANTOM_W_TREMOR_PSD=0.5

# ============ 前端渲染参数（Vite 构建时注入，改后需 --build）============
# 雪花密度/亮度：越大越密/越亮，过大易被密度分析抠图
VITE_PARTICLE_DENSITY=0.6
VITE_PARTICLE_DROP_RATE=0.05
VITE_PARTICLE_BRIGHTNESS=0.55
VITE_PARTICLE_BRIGHTNESS_VAR=0.45
# 预热脉冲时长（秒）：按住按钮后，方块先在起点原地显影这段时间再出发，
# 让用户先熟悉方块位置。改后需 docker compose up -d --build 重 build 前端镜像。
VITE_PREVIEW_SECONDS=2

# 后端 API 地址：默认同源 /api，由 nginx 反代到 backend:8000。
# 生产若用独立域名，把它填进来即可。
VITE_API_BASE=/api